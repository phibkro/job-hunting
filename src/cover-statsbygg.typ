#import "_lib.typ": *

#show: brev.with(
  date: [Oslo, 25. august 2026],
  recipient: [*Statsbygg* \ Produktteamet Digital tjenesteutvikling \ Oslo],
  subject: [Søknad: Fullstack-utvikler],
